/*
 * Nextflow configuration for GSE174609 scRNA-seq workflow.
 */

params {
    samples = "${projectDir}/samples.tsv"
    outdir = "${projectDir}/results"

    cellranger = 'cellranger'
    transcriptome = '/opt/refdata-gex-GRCh38-2024-A'

    expected_cells = 5000
    chemistry = 'SC3Pv3'
    tools_container = "${projectDir}/container/gse174609-tools.sif"
}

/* Run containerized processes with Apptainer/Singularity.
 * Nextflow uses the "singularity" executor integration for both Singularity
 * and Apptainer-compatible runtimes.
 */
singularity {
    enabled = true
    autoMounts = true
    runOptions = '-B /work -B /home -B /tmp'
}

/* Keep failed jobs easier to diagnose. */
process {
    errorStrategy = 'terminate'
    maxRetries = 1
}

/* Local execution profile, useful for dry runs / small tests. */
profiles {

    local {
        process.executor = 'local'
    }

    host {
        singularity.enabled = false
        process.executor = 'local'
    }

    arc {
        process {
            executor = 'slurm'
            queue = 'synergy,cpu2019'
            clusterOptions = '--account=all'
        }
    }
}

/* Execution records / provenance. */
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

